@import "tailwindcss";

/* Minimal custom styles that can't be handled with Tailwind alone */
html {
    scroll-behavior: smooth;
}

/* For RTL text alignment */
.rtl {
    direction: rtl;
}

/* RTL specific fixes */
.rtl\:space-x-reverse {
    --tw-space-x-reverse: 1 !important;
}

html[dir="rtl"] .space-x-4,
html[dir="rtl"] .space-x-8,
html[dir="rtl"] .space-x-12 {
    --tw-space-x-reverse: 1 !important;
}

/* Ensure proper RTL support for Flexbox */
@media (prefers-reduced-motion: no-preference) {
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
}

/* Global focus styles */
*:focus-visible {
    @apply outline-none ring-2 ring-amber-500 ring-offset-2;
}

/* Refinements for Arabic text */
body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Remove default focus outline and use custom one */
:focus {
    outline: none;
}

:focus-visible {
    @apply ring-2 ring-amber-500;
}

/* Simple preloader animation */
@keyframes spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

.animate-spin {
    animation: spin 1s linear infinite;
}

/* Custom animation utilities */
@keyframes pulse-slow {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.05);
  }
}

.animate-pulse-slow {
  animation: pulse-slow 3s ease-in-out infinite;
}

/* Special text reveal animation classes */
.text-reveal, .text-reveal-delayed, .text-reveal-slower {
  opacity: 0;
  transform: translateY(20px);
}

/* Special transforms */
.transform-gpu {
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* Enhanced backdrop blur utilities */
.backdrop-blur-xs {
  backdrop-filter: blur(2px);
}

.backdrop-blur-xl {
  backdrop-filter: blur(24px);
}

/* Additional utility classes */
.hover\:scale-102:hover {
  transform: scale(1.02);
}

.hover\:scale-103:hover {
  transform: scale(1.03);
}

.-z-1 {
  z-index: -1;
}

.-z-4 {
  z-index: -4;
}

.-z-5 {
  z-index: -5;
}

/* Water animation specific styles */
#waterCanvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -10;
}

/* Direction-aware hover effect */
.direction-aware-hover {
  position: relative;
  overflow: hidden;
}

.direction-aware-hover::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(120deg, rgba(194, 145, 12, 0.3), rgba(120, 53, 15, 0.1));
  opacity: 0;
  transform: translateY(100%);
  transition: transform 0.6s ease-out, opacity 0.6s ease-out;
  z-index: -1;
}

.direction-aware-hover:hover::after {
  opacity: 1;
  transform: translateY(0);
}

/* Utility for disabling animation on user preference */
@media (prefers-reduced-motion: reduce) {
    * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

/* Optional print styles for better printing */
@media print {
    body {
        @apply text-black bg-white;
    }

    /* Hide unnecessary elements when printing */
    header, footer, #back-to-top, #preloader {
        display: none !important;
    }

    /* Ensure all text is visible */
    p, h1, h2, h3, h4, h5, h6 {
        color: black !important;
        break-inside: avoid;
    }

    a {
        text-decoration: underline;
        color: black !important;
    }

    /* Add page breaks where appropriate */
    section {
        break-inside: avoid;
    }
}
