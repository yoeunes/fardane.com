@import "tailwindcss";

/* Minimal custom styles that can't be handled with Tailwind alone */
html {
    scroll-behavior: smooth;
}

/* For RTL text alignment */
.rtl {
    direction: rtl;
}

/* RTL specific fixes */
.rtl\:space-x-reverse {
    --tw-space-x-reverse: 1 !important;
}

html[dir="rtl"] .space-x-4,
html[dir="rtl"] .space-x-8,
html[dir="rtl"] .space-x-12 {
    --tw-space-x-reverse: 1 !important;
}

/* Ensure proper RTL support for Flexbox */
@media (prefers-reduced-motion: no-preference) {
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
}

/* Global focus styles */
*:focus-visible {
    @apply outline-none ring-2 ring-amber-500 ring-offset-2;
}

/* Refinements for Arabic text */
body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Remove default focus outline and use custom one */
:focus {
    outline: none;
}

:focus-visible {
    @apply ring-2 ring-amber-500;
}

/* Simple preloader animation */
@keyframes spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

.animate-spin {
    animation: spin 1s linear infinite;
}

/* Custom animation utilities */
@keyframes pulse-slow {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.05);
  }
}

.animate-pulse-slow {
  animation: pulse-slow 3s ease-in-out infinite;
}

/* Special text reveal animation classes */
.text-reveal, .text-reveal-delayed, .text-reveal-slower {
  opacity: 0;
  transform: translateY(20px);
}

/* Special transforms */
.transform-gpu {
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* Enhanced backdrop blur utilities */
.backdrop-blur-xs {
  backdrop-filter: blur(2px);
}

.backdrop-blur-xl {
  backdrop-filter: blur(24px);
}

/* Additional utility classes */
.hover\:scale-102:hover {
  transform: scale(1.02);
}

.hover\:scale-103:hover {
  transform: scale(1.03);
}

.-z-1 {
  z-index: -1;
}

.-z-4 {
  z-index: -4;
}

.-z-5 {
  z-index: -5;
}

/* Water animation specific styles */
#waterCanvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -10;
}

/* Direction-aware hover effect */
.direction-aware-hover {
  position: relative;
  overflow: hidden;
}

.direction-aware-hover::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(120deg, rgba(194, 145, 12, 0.3), rgba(120, 53, 15, 0.1));
  opacity: 0;
  transform: translateY(100%);
  transition: transform 0.6s ease-out, opacity 0.6s ease-out;
  z-index: -1;
}

.direction-aware-hover:hover::after {
  opacity: 1;
  transform: translateY(0);
}

/* Utility for disabling animation on user preference */
@media (prefers-reduced-motion: reduce) {
    * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

/* ==========================================================================
   Arabic Prose Typography Styles
   ========================================================================== */

/* Base prose styling for RTL Arabic content */
.prose-arabic {
    direction: rtl;
    text-align: right;
    line-height: 2;
    font-size: 1.125rem;
}

.prose-arabic h2 {
    @apply text-2xl font-bold text-amber-800 mt-10 mb-5 pb-3 border-b-2 border-amber-200;
    font-family: 'Noto Kufi Arabic', system-ui, sans-serif;
}

.prose-arabic h3 {
    @apply text-xl font-bold text-amber-700 mt-8 mb-4;
    font-family: 'Noto Kufi Arabic', system-ui, sans-serif;
}

.prose-arabic h4 {
    @apply text-lg font-semibold text-stone-700 mt-6 mb-3;
}

.prose-arabic p {
    @apply text-stone-700 mb-5 leading-loose;
}

.prose-arabic ul {
    @apply my-5 pr-6 space-y-2;
    list-style-type: none;
}

.prose-arabic ul li {
    @apply relative pr-6 text-stone-700;
}

.prose-arabic ul li::before {
    content: '◆';
    @apply absolute right-0 text-amber-600 text-sm;
}

.prose-arabic ol {
    @apply my-5 pr-6 space-y-2;
    list-style-type: arabic-indic;
    list-style-position: inside;
}

.prose-arabic ol li {
    @apply text-stone-700;
}

.prose-arabic strong {
    @apply font-bold text-stone-800;
}

.prose-arabic blockquote {
    @apply border-r-4 border-amber-500 pr-5 mr-0 my-6 bg-amber-50/50 py-4 pl-4 rounded-l-lg;
}

.prose-arabic blockquote p {
    @apply text-stone-600 italic mb-0;
}

.prose-arabic a {
    @apply text-amber-700 underline decoration-amber-300 underline-offset-2 hover:text-amber-800 hover:decoration-amber-500 transition-colors;
}

.prose-arabic code {
    @apply bg-stone-100 px-2 py-0.5 rounded text-sm font-mono text-stone-800;
}

.prose-arabic pre {
    @apply bg-stone-900 text-stone-100 p-4 rounded-lg overflow-x-auto my-6 text-left;
    direction: ltr;
}

.prose-arabic hr {
    @apply my-10 border-stone-200;
}

.prose-arabic table {
    @apply w-full my-6 border-collapse;
}

.prose-arabic th {
    @apply bg-amber-100 text-amber-800 font-bold p-3 text-right border border-amber-200;
}

.prose-arabic td {
    @apply p-3 text-right border border-stone-200;
}

.prose-arabic tr:nth-child(even) {
    @apply bg-stone-50;
}

/* First paragraph styling - larger intro text */
.prose-arabic > p:first-of-type {
    @apply text-lg text-stone-600 leading-relaxed;
}

/* Remove top margin from first heading */
.prose-arabic > h2:first-child {
    @apply mt-0;
}

/* Optional print styles for better printing */
@media print {
    body {
        @apply text-black bg-white;
    }

    /* Hide unnecessary elements when printing */
    header, footer, #back-to-top, #preloader {
        display: none !important;
    }

    /* Ensure all text is visible */
    p, h1, h2, h3, h4, h5, h6 {
        color: black !important;
        break-inside: avoid;
    }

    a {
        text-decoration: underline;
        color: black !important;
    }

    /* Add page breaks where appropriate */
    section {
        break-inside: avoid;
    }
}
