{
    "name": "fardane.com",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "concurrently \"bundle exec jekyll serve --livereload\" \"vite\"",
        "dev": "vite",
        "build": "vite build && bundle exec jekyll build",
        "clean": "rm -rf _site .jekyll-cache"
    },
    "dependencies": {
        "@hotwired/stimulus": "^3.2.2"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.14",
        "concurrently": "^9.1.2",
        "tailwindcss": "^4.0.14",
        "vite": "^6.2.2"
    }
}
