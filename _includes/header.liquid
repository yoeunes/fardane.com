<header class="fixed top-0 inset-x-0 transition-colors duration-300 z-50 bg-transparent">
  <div class="container mx-auto px-4 lg:px-6">
    <div class="flex justify-between items-center h-24">
      <!-- Logo -->
      <a href="{{ '/' | relative_url }}" class="flex items-center group">
        <span class="text-2xl font-bold text-amber-900">
          د. فردان
        </span>
        <span class="hidden md:block ms-2 text-sm font-light text-stone-600">
          باحث في تاريخ النظم المائية
        </span>
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden md:block">
        <ul class="flex space-s-8">
          <li><a href="{{ '/' | relative_url }}" class="text-stone-700 hover:text-amber-700 transition-colors">الرئيسية</a></li>
          <li><a href="{{ '/about/' | relative_url }}" class="text-stone-700 hover:text-amber-700 transition-colors">السيرة الذاتية</a></li>
          <li><a href="{{ '/research/' | relative_url }}" class="text-stone-700 hover:text-amber-700 transition-colors">الأبحاث</a></li>
          <li><a href="{{ '/publications/' | relative_url }}" class="text-stone-700 hover:text-amber-700 transition-colors">المنشورات</a></li>
          <li><a href="{{ '/teaching/' | relative_url }}" class="text-stone-700 hover:text-amber-700 transition-colors">التدريس</a></li>
          <li><a href="{{ '/contact/' | relative_url }}" class="text-stone-700 hover:text-amber-700 transition-colors">اتصل بي</a></li>
        </ul>
      </nav>

      <!-- Mobile menu button -->
      <button id="mobile-menu-button" class="md:hidden text-stone-700 hover:text-amber-700 transition-colors">
        <i class="fas fa-bars text-xl"></i>
      </button>
    </div>

    <!-- Mobile menu (hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden pt-4 pb-6 border-t border-stone-200 mt-4">
      <ul class="space-y-3">
        <li><a href="{{ '/' | relative_url }}" class="block py-2 text-stone-700 hover:text-amber-700 transition-colors">الرئيسية</a></li>
        <li><a href="{{ '/about/' | relative_url }}" class="block py-2 text-stone-700 hover:text-amber-700 transition-colors">السيرة الذاتية</a></li>
        <li><a href="{{ '/research/' | relative_url }}" class="block py-2 text-stone-700 hover:text-amber-700 transition-colors">الأبحاث</a></li>
        <li><a href="{{ '/publications/' | relative_url }}" class="block py-2 text-stone-700 hover:text-amber-700 transition-colors">المنشورات</a></li>
        <li><a href="{{ '/teaching/' | relative_url }}" class="block py-2 text-stone-700 hover:text-amber-700 transition-colors">التدريس</a></li>
        <li><a href="{{ '/contact/' | relative_url }}" class="block py-2 text-stone-700 hover:text-amber-700 transition-colors">اتصل بي</a></li>
      </ul>
    </div>
  </div>
</header>

<!-- Spacer to prevent content from hiding behind fixed header -->
<div class="h-24"></div>
