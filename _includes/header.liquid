<header class="fixed top-0 inset-x-0 z-50 transition-all duration-500" data-controller="header">
    <div class="container mx-auto px-6 lg:px-12">
        <!-- Main Header Container -->
        <div class="flex items-center justify-between py-8">
            <!-- Logo Area with Elegant Spacing -->
            <a href="{{ '/' | relative_url }}" class="group flex items-center space-x-4 rtl:space-x-reverse">
                <div class="flex flex-col">
                    <span class="text-3xl font-bold text-white tracking-wide transition-colors duration-300">
                        د. عزيز فردان
                    </span>
                    <div class="h-0.5 w-0 bg-amber-500 group-hover:w-full transition-all duration-500 mt-1"></div>
                </div>
                <div class="hidden md:block h-12 w-px bg-amber-200/50 mx-2"></div>
                <span class="hidden md:block text-base font-light text-white/80 max-w-xs">
                    باحث في تاريخ النظم المائية والعمران بالمغرب الوسيط
                </span>
            </a>

            <!-- Desktop Navigation - Fixed Spacing -->
            <nav class="hidden lg:block">
                <ul class="flex items-center gap-8 xl:gap-10">
                    <li class="px-1">
                        <a href="{{ '/' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300">
                            <span>الرئيسية</span>
                            <div class="h-0.5 w-0 bg-amber-500 group-hover:w-full transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/about' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300">
                            <span>السيرة الذاتية</span>
                            <div class="h-0.5 w-0 bg-amber-500 group-hover:w-full transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/blog' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300">
                            <span>المقالات</span>
                            <div class="h-0.5 w-0 bg-amber-500 group-hover:w-full transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/scientists' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300">
                            <span>الشخصيات العلمية</span>
                            <div class="h-0.5 w-0 bg-amber-500 group-hover:w-full transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Hamburger Button - Elegantly Styled -->
            <button
                type="button"
                class="lg:hidden p-3 group"
                data-action="click->header#toggleMenu"
                aria-label="قائمة"
                data-header-target="menuButton"
            >
                <div class="relative w-8 h-6 flex flex-col justify-between">
                    <span class="w-full h-0.5 bg-white rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span>
                    <span class="w-full h-0.5 bg-white rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span>
                    <span class="w-full h-0.5 bg-white rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span>
                </div>
            </button>
        </div>

        <!-- Mobile Menu Panel -->
        <div
            class="fixed inset-0 bg-stone-900/95 backdrop-blur-md z-40 transition-all duration-500 opacity-0 -translate-y-full invisible lg:hidden"
            data-header-target="mobileMenu"
        >
             <div class="container mx-auto px-6 h-full flex flex-col justify-center">
                <nav class="my-8">
                    <ul class="space-y-8 py-6">
                        <li>
                            <a
                                href="{{ '/' | relative_url }}"
                                class="group flex items-center py-4 text-2xl font-medium text-white hover:text-amber-300 transition-colors"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 text-amber-500 mr-4"><i class="fas fa-home text-xl"></i></span>
                                <span>الرئيسية</span>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/about' | relative_url }}"
                                class="group flex items-center py-4 text-2xl font-medium text-white hover:text-amber-300 transition-colors"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 text-amber-500 mr-4"><i class="fas fa-user-alt text-xl"></i></span>
                                <span>السيرة الذاتية</span>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/blog' | relative_url }}"
                                class="group flex items-center py-4 text-2xl font-medium text-white hover:text-amber-300 transition-colors"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 text-amber-500 mr-4"><i class="fas fa-flask text-xl"></i></span>
                                <span>المقالات</span>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/scientists' | relative_url }}"
                                class="group flex items-center py-4 text-2xl font-medium text-white hover:text-amber-300 transition-colors"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 text-amber-500 mr-4"><i class="fas fa-envelope text-xl"></i></span>
                                <span>الشخصيات العلمية</span>
                            </a>
                        </li>
                    </ul>
                </nav>

                <div class="flex justify-center space-x-8 rtl:space-x-reverse mt-8 pt-8 border-t border-amber-600/30">
                    <a href="#" class="p-3 text-xl text-white/70 hover:text-amber-400 transition-colors">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="p-3 text-xl text-white/70 hover:text-amber-400 transition-colors">
                        <i class="fab fa-linkedin"></i>
                    </a>
                    <a href="#" class="p-3 text-xl text-white/70 hover:text-amber-400 transition-colors">
                        <i class="fab fa-researchgate"></i>
                    </a>
                    <a href="#" class="p-3 text-xl text-white/70 hover:text-amber-400 transition-colors">
                        <i class="fab fa-academia"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
