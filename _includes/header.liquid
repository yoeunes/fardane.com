<header class="fixed top-0 inset-x-0 z-50 transition-all duration-500" data-controller="header">
    <!-- Semi-transparent background gradient for better readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-stone-900/90 to-stone-900/70 backdrop-blur-sm shadow-xl transition-opacity duration-500" data-header-target="background"></div>
    
    <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <!-- Main Header Container with increased spacing -->
        <div class="flex items-center justify-between py-6">
            <!-- Logo Area with Text-based Logo -->
            <a href="{{ '/' | relative_url }}" class="group flex items-center space-x-0 rtl:space-x-reverse">
                <div class="flex flex-col relative">
                    <span class="text-xl md:text-2xl font-bold text-white tracking-normal transition-colors duration-300 font-maghrebi relative whitespace-nowrap">
                        <span class="text-amber-500">د.</span><span class="mr-0.5">عزيز فردان</span>
                        <!-- Underline only for the text itself, not the full width -->
                        <span class="absolute bottom-0 right-0 left-0 h-0.5 w-0 bg-gradient-to-l from-amber-500 to-amber-300 group-hover:w-full origin-right transition-all duration-500"></span>
                    </span>
                </div>
                
                <!-- Decorative separator with subtle animation -->
                <div class="hidden md:flex flex-col items-center justify-center mx-1 opacity-70 group-hover:opacity-100 transition-all duration-500">
                    <div class="w-1 h-1.5 rounded-full bg-amber-500/40 mb-1"></div>
                    <div class="w-px h-8 bg-gradient-to-b from-amber-400/10 via-amber-300/40 to-amber-400/10"></div>
                    <div class="w-1 h-1.5 rounded-full bg-amber-500/40 mt-1"></div>
                </div>
                
                <!-- Academic title with enhanced animation and styling -->
                <div class="hidden md:block relative overflow-hidden">
                    <span class="text-sm font-light text-white/80 transition-all duration-500 group-hover:text-amber-100 inline-block whitespace-nowrap">
                        <span class="inline-block transition-all duration-700 text-amber-400/90 group-hover:text-amber-300 transform group-hover:scale-110 origin-right">باحث</span>
                        <span class="inline-block transition-all duration-300"> في </span>
                        <span class="relative inline-block overflow-hidden">
                            <span class="inline-block transition-transform duration-700 group-hover:translate-y-[-100%] group-hover:opacity-0">النظم المائية</span>
                            <span class="absolute top-0 right-0 inline-block transition-transform duration-700 translate-y-full opacity-0 text-amber-200 group-hover:translate-y-0 group-hover:opacity-100 font-medium">النظم المائية</span>
                        </span>
                        <span class="inline-block group-hover:opacity-80 transition-opacity duration-500"> والعمران</span>
                        <span class="relative inline-block overflow-hidden">
                            <span class="inline-block transition-all duration-500 group-hover:opacity-0"> بالمغرب</span>
                            <span class="absolute top-0 right-0 inline-block transition-all duration-700 opacity-0 text-amber-300/90 group-hover:opacity-100 font-medium"> بالمغرب</span>
                        </span>
                    </span>
                    <!-- Subtle glow effect that appears on hover -->
                    <div class="absolute inset-0 bg-gradient-to-r from-amber-500/0 via-amber-500/5 to-amber-500/0 opacity-0 group-hover:opacity-100 blur-md transition-opacity duration-700 pointer-events-none"></div>
                </div>
            </a>

            <!-- Extra spacing div -->
            <div class="flex-grow"></div>

            <!-- Desktop Navigation with highlight for current page -->
            <nav class="hidden lg:block ml-8">
                <ul class="flex items-center gap-8 xl:gap-10">
                    <li class="px-1">
                        <a href="{{ '/' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300 relative {% if page.url == '/' %}active-nav{% endif %}">
                            <span>الرئيسية</span>
                            <div class="h-0.5 {% if page.url == '/' %}w-full bg-amber-500{% else %}w-0 bg-amber-500 group-hover:w-full{% endif %} transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/about' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300 relative {% if page.url contains '/about' %}active-nav{% endif %}">
                            <span>السيرة الذاتية</span>
                            <div class="h-0.5 {% if page.url contains '/about' %}w-full bg-amber-500{% else %}w-0 bg-amber-500 group-hover:w-full{% endif %} transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/research' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300 relative {% if page.url contains '/research' %}active-nav{% endif %}">
                            <span>الأبحاث</span>
                            <div class="h-0.5 {% if page.url contains '/research' %}w-full bg-amber-500{% else %}w-0 bg-amber-500 group-hover:w-full{% endif %} transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/blog' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300 relative {% if page.url contains '/blog' %}active-nav{% endif %}">
                            <span>المقالات</span>
                            <div class="h-0.5 {% if page.url contains '/blog' %}w-full bg-amber-500{% else %}w-0 bg-amber-500 group-hover:w-full{% endif %} transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/scientists' | relative_url }}" class="group block py-2 text-lg text-white hover:text-amber-300 transition-colors duration-300 relative {% if page.url contains '/scientists' %}active-nav{% endif %}">
                            <span>العلماء</span>
                            <div class="h-0.5 {% if page.url contains '/scientists' %}w-full bg-amber-500{% else %}w-0 bg-amber-500 group-hover:w-full{% endif %} transition-all duration-300 mt-1"></div>
                        </a>
                    </li>
                    <li class="px-1">
                        <a href="{{ '/contact' | relative_url }}" class="group inline-flex items-center py-2 px-5 text-lg text-white bg-amber-700 hover:bg-amber-600 rounded-lg transition-colors duration-300 mr-3">
                            <i class="fas fa-envelope ml-2 text-amber-300"></i>
                            <span>تواصل معنا</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Hamburger Button - Elegantly Styled -->
            <button
                type="button"
                class="lg:hidden p-3 group"
                data-action="click->header#toggleMenu"
                aria-label="قائمة"
                data-header-target="menuButton"
            >
                <div class="relative w-8 h-6 flex flex-col justify-between">
                    <span class="w-full h-0.5 bg-white rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span>
                    <span class="w-full h-0.5 bg-white rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span>
                    <span class="w-full h-0.5 bg-white rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span>
                </div>
            </button>
        </div>

        <!-- Mobile Menu Panel with enhanced design -->
        <div
            class="fixed inset-0 bg-stone-900/95 backdrop-blur-md z-40 transition-all duration-500 opacity-0 -translate-y-full invisible lg:hidden"
            data-header-target="mobileMenu"
        >
            <div class="container mx-auto px-6 h-full flex flex-col justify-center">
                <div class="flex items-center justify-center mb-8">
                    <!-- Logo for mobile menu -->
                    <div class="text-center">
                        <h2 class="text-3xl font-bold text-white font-maghrebi">د. عزيز فردان</h2>
                        <p class="text-amber-500/80 text-sm mt-1">باحث في تاريخ النظم المائية والعمران</p>
                    </div>
                </div>
                
                <nav class="my-8">
                    <ul class="space-y-5 py-6">
                        <li>
                            <a
                                href="{{ '/' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-home text-lg"></i></span>
                                <span>الرئيسية</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/about' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-user-alt text-lg"></i></span>
                                <span>السيرة الذاتية</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/research' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-flask text-lg"></i></span>
                                <span>الأبحاث</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/blog' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-newspaper text-lg"></i></span>
                                <span>المقالات</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/scientists' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-user-graduate text-lg"></i></span>
                                <span>العلماء</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/publications' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-book text-lg"></i></span>
                                <span>المنشورات</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                        <li>
                            <a
                                href="{{ '/contact' | relative_url }}"
                                class="group flex items-center py-3 text-2xl font-medium text-white hover:text-amber-300 transition-colors relative overflow-hidden"
                                data-action="click->header#closeMenu"
                            >
                                <span class="w-10 h-10 rounded-full bg-amber-700/20 flex items-center justify-center text-amber-500 ml-4"><i class="fas fa-envelope text-lg"></i></span>
                                <span>تواصل معنا</span>
                                <div class="absolute bottom-0 right-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-500"></div>
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- Academic social media links -->
                <div class="flex justify-center space-x-4 rtl:space-x-reverse mt-8 pt-8 border-t border-amber-600/30">
                    <a href="#" class="w-12 h-12 rounded-full bg-stone-800 flex items-center justify-center text-white/70 hover:bg-amber-700 hover:text-white transition-all duration-300">
                        <i class="fab fa-linkedin"></i>
                    </a>
                    <a href="#" class="w-12 h-12 rounded-full bg-stone-800 flex items-center justify-center text-white/70 hover:bg-amber-700 hover:text-white transition-all duration-300">
                        <i class="fab fa-researchgate"></i>
                    </a>
                    <a href="#" class="w-12 h-12 rounded-full bg-stone-800 flex items-center justify-center text-white/70 hover:bg-amber-700 hover:text-white transition-all duration-300">
                        <i class="fab fa-academia"></i>
                    </a>
                    <a href="#" class="w-12 h-12 rounded-full bg-stone-800 flex items-center justify-center text-white/70 hover:bg-amber-700 hover:text-white transition-all duration-300">
                        <i class="fas fa-graduation-cap"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
/* Add additional styling for the active navigation state */
.active-nav {
    color: theme('colors.amber.300');
}
</style>
