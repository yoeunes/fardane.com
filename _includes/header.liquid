<header class="relative z-50" data-controller="header">
    <div class="absolute inset-0 bg-white shadow-sm"></div>
    <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="flex items-center justify-between py-4">
            <a href="{{ '/' | relative_url }}" class="group flex items-center rtl:space-x-reverse">
                <div class="flex flex-col relative inline-block">
                    <span class="text-2xl md:text-3xl font-bold text-stone-900 tracking-wide transition-colors duration-300 font-maghrebi relative">
                        <span class="text-amber-600">د.</span> عزيز فردان
                        <span class="absolute bottom-0 right-0 left-0 h-0.5 w-0 bg-gradient-to-l from-amber-600 to-amber-400 group-hover:w-full origin-right transition-all duration-500"></span>
                    </span>
                </div>
            </a>
            <div class="flex-grow"></div>

            <nav class="hidden lg:block ml-8">
                <ul class="flex items-center gap-6 xl:gap-8">
                    <li class="px-1"><a href="{{ '/' | relative_url }}" class="group block py-2 text-base text-stone-700 hover:text-amber-700 transition-colors duration-300 relative"><span>الرئيسية</span><div class="h-0.5 w-0 bg-amber-600 group-hover:w-full transition-all duration-300 mt-1"></div></a></li>
                    <li class="px-1"><a href="{{ '/news' | relative_url }}" class="group block py-2 text-base text-stone-700 hover:text-amber-700 transition-colors duration-300 relative"><span>أخبار</span><div class="h-0.5 w-0 bg-amber-600 group-hover:w-full transition-all duration-300 mt-1"></div></a></li>
                    <li class="px-1"><a href="{{ '/articles' | relative_url }}" class="group block py-2 text-base text-stone-700 hover:text-amber-700 transition-colors duration-300 relative"><span>المنشورات</span><div class="h-0.5 w-0 bg-amber-600 group-hover:w-full transition-all duration-300 mt-1"></div></a></li>
                    <li class="px-1"><a href="{{ '/scientists' | relative_url }}" class="group block py-2 text-base text-stone-700 hover:text-amber-700 transition-colors duration-300 relative"><span>العلماء</span><div class="h-0.5 w-0 bg-amber-600 group-hover:w-full transition-all duration-300 mt-1"></div></a></li>
                    <li class="px-1"><a href="{{ '/about' | relative_url }}" class="group block py-2 text-base text-stone-700 hover:text-amber-700 transition-colors duration-300 relative"><span>السيرة الذاتية</span><div class="h-0.5 w-0 bg-amber-600 group-hover:w-full transition-all duration-300 mt-1"></div></a></li>
                    <li class="px-1"><a href="{{ '/uca' | relative_url }}" class="group block py-2 text-base text-stone-700 hover:text-amber-700 transition-colors duration-300 relative"><span>تاريخ الجامعة</span><div class="h-0.5 w-0 bg-amber-600 group-hover:w-full transition-all duration-300 mt-1"></div></a></li>
                </ul>
            </nav>

            <button type="button" class="lg:hidden p-3 group" data-action="click->header#toggleMenu" aria-label="قائمة" data-header-target="menuButton">
                <span class="relative w-7 h-5 flex flex-col justify-between"><span class="w-full h-0.5 bg-stone-800 rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span><span class="w-full h-0.5 bg-stone-800 rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span><span class="w-full h-0.5 bg-stone-800 rounded transition-all duration-300 ease-in-out" data-header-target="hamburgerLine"></span></span>
            </button>
        </div>

        <div class="fixed inset-0 bg-white z-40 transition-all duration-500 opacity-0 -translate-y-full invisible lg:hidden" data-header-target="mobileMenu">
            <div class="container mx-auto px-6 h-full flex flex-col justify-center">
                <!-- Close button -->
                <button type="button" class="absolute top-6 right-6 p-3 rounded-full hover:bg-stone-100 transition-colors duration-200 group" data-action="click->header#closeMenu" aria-label="إغلاق القائمة">
                    <svg class="w-6 h-6 text-stone-600 group-hover:text-stone-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
                <nav class="my-8">
                    <ul class="space-y-4 py-6">
                        <li><a href="{{ '/' | relative_url }}" class="group flex items-center py-4 text-lg font-medium text-stone-800 hover:text-amber-700" data-action="click->header#closeMenu"><span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 ml-4"><i class="fas fa-home text-lg"></i></span><span>الرئيسية</span></a></li>
                        <li><a href="{{ '/news' | relative_url }}" class="group flex items-center py-4 text-lg font-medium text-stone-800 hover:text-amber-700" data-action="click->header#closeMenu"><span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 ml-4"><i class="fas fa-bullhorn text-lg"></i></span><span>أخبار</span></a></li>
                        <li><a href="{{ '/articles' | relative_url }}" class="group flex items-center py-4 text-lg font-medium text-stone-800 hover:text-amber-700" data-action="click->header#closeMenu"><span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 ml-4"><i class="fas fa-newspaper text-lg"></i></span><span>المنشورات</span></a></li>
                        <li><a href="{{ '/scientists' | relative_url }}" class="group flex items-center py-4 text-lg font-medium text-stone-800 hover:text-amber-700" data-action="click->header#closeMenu"><span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 ml-4"><i class="fas fa-user-graduate text-lg"></i></span><span>العلماء</span></a></li>
                        <li><a href="{{ '/about' | relative_url }}" class="group flex items-center py-4 text-lg font-medium text-stone-800 hover:text-amber-700" data-action="click->header#closeMenu"><span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 ml-4"><i class="fas fa-user-alt text-lg"></i></span><span>السيرة الذاتية</span></a></li>
                        <li><a href="{{ '/uca' | relative_url }}" class="group flex items-center py-4 text-lg font-medium text-stone-800 hover:text-amber-700" data-action="click->header#closeMenu"><span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 ml-4"><i class="fas fa-university text-lg"></i></span><span>تاريخ الجامعة</span></a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</header>
