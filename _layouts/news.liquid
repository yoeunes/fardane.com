---
layout: default
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "الرئيسية",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "مستجدات",
      "item": "{{ site.url }}/news/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ page.title | escape }}",
      "item": "{{ page.url | absolute_url }}"
    }
  ]
}
</script>
<header class="relative dir-rtl overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-950 via-amber-900 to-stone-950">
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 left-1/4 w-1/3 h-full bg-amber-400 blur-[100px] rotate-12 transform -translate-y-1/2"></div>
            <div class="absolute bottom-0 right-1/4 w-1/3 h-full bg-amber-600 blur-[100px] -rotate-12 transform translate-y-1/2"></div>
        </div>
    </div>
    <div class="relative z-10">
        <div class="container mx-auto px-6 py-16 md:py-20">
            <div class="max-w-3xl mx-auto text-center" data-controller="reveal-animation">
                <div class="inline-block mb-6 px-4 py-1.5 rounded-full border border-amber-500/30 bg-gradient-to-r from-amber-800/40 to-amber-900/40 backdrop-blur-sm">
                    <span class="text-amber-200 text-sm font-medium tracking-wide">{{ page.type | default: 'إعلان' }}</span>
                </div>
                <h1 class="text-white text-4xl md:text-5xl font-bold mb-6 font-maghrebi leading-tight">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-300 to-amber-100">{{ page.title }}</span>
                </h1>
                <p class="text-amber-100/80 text-lg"><i class="far fa-calendar-alt ml-2"></i>{% include arabic-date.html date=page.date %}</p>
            </div>
        </div>
    </div>
    <div class="relative"><div class="absolute -bottom-10 left-0 right-0 h-20 bg-white transform -skew-y-1.5 shadow-sm"></div></div>
</header>

<section class="py-12 md:py-16 dir-rtl bg-white pt-16">
  <div class="container mx-auto px-8">
    <div class="max-w-3xl mx-auto">
      {% if page.thumbnail %}
      {% assign _thumb_key = page.thumbnail | remove_first: '/' %}
      <div class="rounded-xl overflow-hidden mb-10 shadow-md">
        <img src="{{ site.data.manifest[_thumb_key] | default: page.thumbnail }}" alt="{{ page.title }}" class="w-full h-auto" loading="lazy">
      </div>
      {% endif %}
      <article class="prose prose-lg prose-stone max-w-none rtl text-right">
        {{ content }}
      </article>
      {% if page.external_url %}
      <div class="mt-12 text-center">
        <a href="{{ page.external_url }}" target="_blank" class="inline-block px-8 py-3 bg-gradient-to-r from-amber-700 to-amber-600 text-white rounded-lg hover:from-amber-600 hover:to-amber-500 transition-all duration-300 shadow-lg">
            زيارة الرابط الرسمي
        </a>
      </div>
      {% endif %}

      <!-- Back to news link -->
      <div class="mt-12 pt-6 border-t border-stone-200">
        <a href="/news/" class="group text-lg font-medium text-amber-800 hover:text-amber-600 flex items-center">
          <i class="fas fa-arrow-right ml-2 transform transition-transform group-hover:translate-x-1"></i>
          <span>العودة إلى المستجدات</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Related News Section -->
{% assign related_news = site.news | where_exp: "item", "item.url != page.url" | sort: 'date' | reverse | limit: 3 %}
{% if related_news.size > 0 %}
<section class="py-16 bg-stone-50 dir-rtl">
  <div class="container mx-auto px-8">
    <div class="mb-10 text-center">
      <h2 class="text-3xl font-bold text-amber-800 mb-4 font-maghrebi">مستجدات أخرى</h2>
      <div class="flex items-center justify-center">
        <div class="h-px w-20 bg-amber-400"></div>
        <div class="mx-4"><i class="fas fa-newspaper text-amber-500"></i></div>
        <div class="h-px w-20 bg-amber-400"></div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for item in related_news %}
      <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-stone-200 flex flex-col overflow-hidden">
        {% if item.thumbnail %}
        <div class="overflow-hidden h-44">
          {% assign _rn_key = item.thumbnail | remove_first: '/' %}
          <a href="{{ item.url | relative_url }}">
            <img src="{% if item.thumbnail contains '://' %}{{ item.thumbnail }}{% else %}{{ site.data.manifest[_rn_key] | default: item.thumbnail }}{% endif %}" alt="{{ item.title }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy">
          </a>
        </div>
        {% endif %}
        <div class="p-5 flex flex-col flex-grow">
          <span class="text-xs font-semibold text-amber-700 mb-2">{{ item.type | default: 'إعلان' }}</span>
          <h3 class="text-lg font-bold text-amber-900 mb-2 line-clamp-2">
            <a href="{{ item.url | relative_url }}" class="hover:text-amber-700 transition-colors">{{ item.title }}</a>
          </h3>
          <p class="text-sm text-stone-600 line-clamp-2 flex-grow">{{ item.description }}</p>
          <div class="mt-4 pt-3 border-t border-stone-100 text-sm text-stone-500">
            <i class="far fa-calendar-alt ml-1 text-amber-500"></i>
            {% include arabic-date.html date=item.date %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
