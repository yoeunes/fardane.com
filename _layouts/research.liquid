---
layout: default
---

<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <a href="{{ '/research/' | relative_url }}" class="inline-flex items-center text-amber-600 hover:text-amber-800">
      <i class="fas fa-arrow-right ml-2"></i>
      العودة للأبحاث
    </a>
  </div>

  <article class="bg-white rounded-2xl p-8 shadow-sm mb-8">
    <h1 class="text-3xl font-bold text-amber-900 mb-6">{{ page.title }}</h1>

    {% if page.featured_image %}
    {% assign _fi_key = page.featured_image | remove_first: '/' %}
    <div class="mb-6">
      <img src="{{ site.data.manifest[_fi_key] | default: page.featured_image }}" alt="{{ page.title }}" class="w-full h-80 object-cover rounded-xl">
    </div>
    {% endif %}

    <div class="prose max-w-none text-stone-700">
      {{ content }}
    </div>
  </article>
</div>
