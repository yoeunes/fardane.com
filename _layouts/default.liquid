<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ page.description | default: site.description }}">

    <!-- Favicons -->
    <link rel="icon" href="{{ '/assets/images/favicon.ico' | relative_url }}" sizes="any">
    <link rel="icon" href="{{ '/assets/images/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ '/assets/images/apple-touch-icon.png' | relative_url }}">

    <!-- تضمين الخطوط العربية -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@100..900&display=swap" rel="stylesheet">

    <!-- تضمين Font Awesome للأيقونات -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Meta tags for social sharing -->
    <meta property="og:title" content="{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}">
    <meta property="og:description" content="{{ page.description | default: site.description }}">
    <meta property="og:image" content="{{ site.url }}{{ '/assets/images/social-share.jpg' | relative_url }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">

    <!-- Vite Development Mode Assets -->
    {% if jekyll.environment != "production" %}
        <script type="module" src="http://localhost:5173/@vite/client"></script>
        <script type="module" src="http://localhost:5173/assets/js/main.js"></script>
    {% else %}
        <!-- Production Mode Assets -->
        <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
        <script type="module" src="{{ '/assets/js/main.js' | relative_url }}"></script>
    {% endif %}

    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>

    <!-- إضافة دعم RTL لـ Tailwind CSS -->
    <style>
        :root {
            --font-family: 'Noto Kufi Arabic', system-ui, sans-serif;
        }

        body {
            font-family: var(--font-family);
        }
    </style>
</head>
<body class="animated-bg text-stone-900 min-h-screen flex flex-col">
<!-- Preloader (hidden after page loads) -->
<div id="preloader" class="fixed inset-0 bg-sand-50 z-50 flex items-center justify-center">
    <div class="animate-pulse-slow">
        <svg width="80" height="80" viewBox="0 0 100 100">
            <circle class="text-amber-200" stroke="currentColor" stroke-width="8" fill="none" cx="50" cy="50"
                    r="40"></circle>
            <path class="text-amber-600" stroke="currentColor" stroke-width="8" fill="none"
                  d="M 50 10 A 40 40 0 0 1 90 50" stroke-linecap="round">
                <animateTransform attributeName="transform" type="rotate" from="0 50 50" to="360 50 50" dur="1s"
                                  repeatCount="indefinite"></animateTransform>
            </path>
        </svg>
    </div>
</div>

<!-- Background particles -->
<div id="particles-js" class="fixed inset-0 pointer-events-none opacity-30"></div>

<!-- الهيدر -->
{% include header.html %}

<!-- المحتوى الرئيسي -->
<main class="flex-grow" data-controller="scroll-animation">
    {{ content }}
</main>

<!-- الفوتر -->
{% include footer.html %}

<!-- Back to top button -->
<button id="back-to-top"
        class="fixed bottom-8 left-8 bg-amber-600 text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center opacity-0 transition-opacity duration-300 hover:bg-amber-700">
    <i class="fas fa-arrow-up"></i>
</button>

<!-- Page transition overlay -->
<div id="page-transition" class="fixed inset-0 bg-amber-900 z-50 transform translate-y-full pointer-events-none"></div>

<script>
    // Preloader
    window.addEventListener('load', function () {
        const preloader = document.getElementById('preloader');
        preloader.classList.add('opacity-0');
        setTimeout(() => {
            preloader.style.display = 'none';
        }, 500);
    });

    // Back to top button
    const backToTopButton = document.getElementById('back-to-top');
    window.addEventListener('scroll', function () {
        if (window.scrollY > 300) {
            backToTopButton.classList.replace('opacity-0', 'opacity-100');
        } else {
            backToTopButton.classList.replace('opacity-100', 'opacity-0');
        }
    });
    backToTopButton.addEventListener('click', function () {
        window.scrollTo({top: 0, behavior: 'smooth'});
    });

    // Page transitions (for future implementation with Barba.js or similar)
    document.addEventListener('DOMContentLoaded', function () {
        const pageTransition = document.getElementById('page-transition');
        // Animation on page load
        gsap.fromTo(pageTransition,
            {translateY: 0},
            {translateY: '-100%', duration: 0.8, ease: "power3.inOut"}
        );
    });
</script>
</body>
</html>
