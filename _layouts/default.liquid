<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
        <meta name="description" content="{{ page.description | default: site.description }}">

        <!-- Favicons -->
        <link rel="icon" href="{{ '/dist/images/favicon.ico' | relative_url }}" sizes="any">
        <link rel="icon" href="{{ '/dist/images/favicon.svg' | relative_url }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ '/dist/images/apple-touch-icon.png' | relative_url }}">

        <!-- Arabic fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@100..900&display=swap" rel="stylesheet">

        <!-- Font Awesome icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <!-- Meta tags for social sharing -->
        <meta property="og:title" content="{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}">
        <meta property="og:description" content="{{ page.description | default: site.description }}">
        <meta property="og:image" content="{{ site.url }}{{ '/dist/images/social-share.jpg' | relative_url }}">
        <meta property="og:url" content="{{ site.url }}{{ page.url }}">
        <meta property="og:type" content="website">
        <meta name="twitter:card" content="summary_large_image">

        <!-- In your layout file -->
        {% if jekyll.environment == "development" %}
          <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
          <meta http-equiv="Pragma" content="no-cache" />
          <meta http-equiv="Expires" content="0" />
        {% else %}
          <!-- Production caching strategy -->
          <meta http-equiv="Cache-Control" content="public, max-age=3600" />
        {% endif %}

        <!-- Styles -->
        <link rel="stylesheet" href="{{ site.data.manifest['dist/main.css'] }}"/>

        <!-- RTL support for Tailwind CSS -->
        <style>
            :root {
                --font-family: 'Noto Kufi Arabic', system-ui, sans-serif;
            }

            body {
                font-family: var(--font-family);
            }

            /* Header scroll effect */
            header {
                background-color: transparent;
                transition: background-color 0.3s ease;
            }

            header.scrolled {
                background-color: white;
            }

            header.scrolled .text-white {
                color: #1c1917; /* stone-900 */
            }

            header.scrolled .text-white\/80 {
                color: rgba(28, 25, 23, 0.8); /* stone-900/80 */
            }

            header.scrolled .hover\:text-amber-300:hover {
                color: #d97706; /* amber-600 */
            }

            header.scrolled .bg-white\/95 {
                background-color: rgba(255, 255, 255, 0.95);
            }

            header.scrolled [data-header-target="hamburgerLine"] {
                background-color: #92400e; /* amber-800 */
            }
        </style>

        <!-- Scripts -->
        <script defer src="{{ site.data.manifest['dist/main.js'] }}"></script>
    </head>
    <body class="bg-stone-50 text-stone-900 min-h-screen flex flex-col">
        <!-- Simple preloader -->
        <div id="preloader" class="fixed inset-0 bg-sand-50 z-50 flex items-center justify-center">
            <div class="animate-pulse">
                <div class="w-16 h-16 border-4 border-amber-600 border-b-transparent rounded-full animate-spin"></div>
            </div>
        </div>

        <!-- Header -->
        {% include header.liquid %}

        <!-- Main content -->
        <main class="flex-grow">
            {{ content }}
        </main>

        <!-- Footer -->
        {% include footer.liquid %}

        <!-- Back to top button -->
        <button id="back-to-top"
                class="fixed bottom-8 left-8 bg-amber-600 text-white w-12 h-12 rounded-full shadow-md flex items-center justify-center opacity-0 transition-opacity duration-300 hover:bg-amber-700">
            <i class="fas fa-arrow-up"></i>
        </button>

        <!-- Header scroll effect script -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const header = document.querySelector('header');

                window.addEventListener('scroll', function() {
                    if (window.scrollY > 100) {
                        header.classList.add('scrolled');
                    } else {
                        header.classList.remove('scrolled');
                    }
                });

                // Check initial scroll position
                if (window.scrollY > 100) {
                    header.classList.add('scrolled');
                }
            });
        </script>
    </body>
</html>
