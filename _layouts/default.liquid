<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
        <meta name="description" content="{{ page.description | default: site.description }}">

        <!-- Favicons -->
        <link rel="icon" href="{{ '/assets/images/favicon.ico' | relative_url }}" sizes="any">
        <link rel="icon" href="{{ '/assets/images/favicon.svg' | relative_url }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ '/assets/images/apple-touch-icon.png' | relative_url }}">

        <!-- Arabic fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@100..900&display=swap" rel="stylesheet">

        <!-- Font Awesome icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <!-- Meta tags for social sharing -->
        <meta property="og:title" content="{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}">
        <meta property="og:description" content="{{ page.description | default: site.description }}">
        <meta property="og:image" content="{{ site.url }}{{ '/assets/images/social-share.jpg' | relative_url }}">
        <meta property="og:url" content="{{ site.url }}{{ page.url }}">
        <meta property="og:type" content="website">
        <meta name="twitter:card" content="summary_large_image">

        <!-- Vite Assets -->
        {% if jekyll.environment == "development" %}
            <!-- Development mode: Use Vite dev server -->
            <script type="module" src="http://localhost:5173/assets/js/main.js"></script>
        {% else %}
            <!-- Production mode: Use built assets -->
            {% assign manifest_path = site.source | append: '/assets/dist/.vite/manifest.json' %}
            {% if site.static_files | where: "path", manifest_path | first %}
                {% assign manifest = site.static_files | where: "path", manifest_path | first | map: "content" | first | jsonify %}
                {% if manifest.assets/js/main.js %}
                    <script type="module" src="{{ '/assets/dist/' | append: manifest.assets/js/main.js.file | relative_url }}"></script>
                {% else %}
                    <!-- Fallback to direct path if asset not in manifest -->
                    <script type="module" src="{{ '/assets/dist/js/main.js' | relative_url }}"></script>
                {% endif %}
            {% else %}
                <!-- Fallback if manifest doesn't exist -->
                <script type="module" src="{{ '/assets/dist/js/main.js' | relative_url }}"></script>
            {% endif %}
        {% endif %}

        <!-- RTL support for Tailwind CSS -->
        <style>
            :root {
                --font-family: 'Noto Kufi Arabic', system-ui, sans-serif;
            }

            body {
                font-family: var(--font-family);
            }
        </style>
    </head>
    <body class="bg-stone-50 text-stone-900 min-h-screen flex flex-col">
        <!-- Simple preloader -->
        <div id="preloader" class="fixed inset-0 bg-sand-50 z-50 flex items-center justify-center">
            <div class="animate-pulse">
                <div class="w-16 h-16 border-4 border-amber-600 border-b-transparent rounded-full animate-spin"></div>
            </div>
        </div>

        <!-- Header -->
        {% include header.liquid %}

        <!-- Main content -->
        <main class="flex-grow">
            {{ content }}
        </main>

        <!-- Footer -->
        {% include footer.liquid %}

        <!-- Back to top button -->
        <button id="back-to-top"
                class="fixed bottom-8 left-8 bg-amber-600 text-white w-12 h-12 rounded-full shadow-md flex items-center justify-center opacity-0 transition-opacity duration-300 hover:bg-amber-700">
            <i class="fas fa-arrow-up"></i>
        </button>
    </body>
</html>
