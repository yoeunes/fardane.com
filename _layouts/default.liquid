<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
    <head>
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-1H5F625Z31"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-1H5F625Z31');
        </script>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
        <meta name="description" content="{{ page.description | default: site.description }}">
        <meta name="keywords" content="{{ page.keywords | default: site.keywords }}">
        <meta name="author" content="{{ site.author }}">

        {% if page.noindex %}
        <meta name="robots" content="noindex, nofollow">
        {% endif %}

        <!-- Favicons -->
        <link rel="icon" href="{{ site.data.manifest['dist/images/favicon.svg'] | default: '/dist/images/favicon.svg' }}" sizes="any">
        <link rel="apple-touch-icon" href="{{ site.data.manifest['dist/images/apple-touch-icon.png'] | default: '/dist/images/apple-touch-icon.png' }}">

        <!-- Arabic fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@100..900&display=swap" rel="stylesheet">

        <!-- Font Awesome icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <!-- Canonical URL -->
        <link rel="canonical" href="{{ page.url | absolute_url }}">

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="{% if page.layout == 'post' or page.layout == 'news' or page.layout == 'news-article' or page.layout == 'scientist' %}article{% else %}website{% endif %}">
        <meta property="og:url" content="{{ page.url | absolute_url }}">
        <meta property="og:title" content="{{ page.title | default: site.title }}">
        <meta property="og:description" content="{{ page.description | default: site.description | strip_html | truncate: 200 }}">
        <meta property="og:site_name" content="{{ site.title }}">
        <meta property="og:locale" content="ar_MA">
        {% if page.image %}
        {% assign _og_img_key = page.image | remove_first: '/' %}
        <meta property="og:image" content="{{ site.data.manifest[_og_img_key] | default: page.image | absolute_url }}">
        {% elsif page.thumbnail %}
        {% assign _og_img_key = page.thumbnail | remove_first: '/' %}
        <meta property="og:image" content="{{ site.data.manifest[_og_img_key] | default: page.thumbnail | absolute_url }}">
        {% else %}
        <meta property="og:image" content="{{ site.url }}{{ site.data.manifest['dist/images/profile.png'] | default: '/dist/images/profile.png' }}">
        {% endif %}
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:url" content="{{ page.url | absolute_url }}">
        <meta name="twitter:title" content="{{ page.title | default: site.title }}">
        <meta name="twitter:description" content="{{ page.description | default: site.description | strip_html | truncate: 200 }}">
        {% if page.image %}
        {% assign _tw_img_key = page.image | remove_first: '/' %}
        <meta name="twitter:image" content="{{ site.data.manifest[_tw_img_key] | default: page.image | absolute_url }}">
        {% elsif page.thumbnail %}
        {% assign _tw_img_key = page.thumbnail | remove_first: '/' %}
        <meta name="twitter:image" content="{{ site.data.manifest[_tw_img_key] | default: page.thumbnail | absolute_url }}">
        {% else %}
        <meta name="twitter:image" content="{{ site.url }}{{ site.data.manifest['dist/images/profile.png'] | default: '/dist/images/profile.png' }}">
        {% endif %}
        {% if site.twitter.username %}
        <meta name="twitter:site" content="@{{ site.twitter.username }}">
        {% endif %}

        <!-- Meta tags for social sharing -->
        {% seo %}

        <!-- Structured Data -->
        {% if page.url == "/" or page.url == "/index.html" %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Person",
              "name": "د. عزيز فردان",
              "jobTitle": "باحث في تاريخ النظم المائية والعمران",
              "affiliation": {
                "@type": "Organization",
                "name": "جامعة القاضي عياض",
                "url": "http://www.uca.ma"
              },
              "url": "{{ site.url }}",
              "image": "{{ site.url }}{{ site.data.manifest['dist/images/profile.png'] | default: '/dist/images/profile.png' }}",
              "sameAs": [
                "https://www.linkedin.com/in/aziz-fardane-gis1948/"
              ],
              "knowsAbout": [
                "تاريخ المياه",
                "تاريخ المغرب الوسيط",
                "حضارة إسلامية",
                "نظم مائية تقليدية",
                "واحات مغربية",
                "طوبونيميا"
              ]
            },
            {
              "@type": "Organization",
              "name": "جامعة القاضي عياض",
              "url": "http://www.uca.ma",
              "logo": "{{ site.url }}{{ site.data.manifest['dist/images/university-logo.png'] | default: '/dist/images/university-logo.png' }}",
              "description": "جامعة القاضي عياض هي جامعة مغربية تقع في مدينة مراكش",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "مراكش",
                "addressCountry": "المغرب"
              },
              "sameAs": [
                "http://www.uca.ma"
              ]
            }
          ]
        }
        </script>
        {% endif %}

        <!-- Article Structured Data for Posts -->
        {% if page.layout == "post" %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Article",
          "headline": "{{ page.title | escape }}",
          "description": "{{ page.description | default: page.excerpt | strip_html | truncate: 160 | escape }}",
          {% assign _ld_thumb_key = page.thumbnail | remove_first: '/' %}
          "image": {
            "@type": "ImageObject",
            "url": "{{ site.data.manifest[_ld_thumb_key] | default: page.thumbnail | default: '/dist/images/articles/default.jpg' | absolute_url }}"
          },
          "datePublished": "{{ page.date | date_to_xmlschema }}",
          "dateModified": "{{ page.last_modified_at | default: page.date | date_to_xmlschema }}",
          "author": {
            "@type": "Person",
            "name": "د. عزيز فردان",
            "url": "{{ site.url }}",
            "image": "{{ site.url }}{{ site.data.manifest['dist/images/profile.png'] | default: '/dist/images/profile.png' }}"
          },
          "publisher": {
            "@type": "Organization",
            "name": "{{ site.title }}",
            "url": "{{ site.url }}",
            "logo": {
              "@type": "ImageObject",
              "url": "{{ site.url }}{{ site.data.manifest['dist/images/university-logo.png'] | default: '/dist/images/university-logo.png' }}"
            }
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ page.url | absolute_url }}"
          },
          "url": "{{ page.url | absolute_url }}",
          "keywords": "{{ page.tags | join: ', ' | escape }}",
          "articleSection": "{{ page.categories | first | escape }}",
          "inLanguage": "ar"
        }
        </script>
        {% endif %}

        <!-- NewsArticle Structured Data for News -->
        {% if page.layout == "news-article" or page.layout == "news" %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "NewsArticle",
          "headline": "{{ page.title | escape }}",
          "description": "{{ page.description | strip_html | truncate: 160 | escape }}",
          {% assign _ld_news_key = page.thumbnail | remove_first: '/' %}
          "image": {
            "@type": "ImageObject",
            "url": "{{ site.data.manifest[_ld_news_key] | default: page.thumbnail | default: '/dist/images/news/default.jpg' | absolute_url }}"
          },
          "datePublished": "{{ page.date | date_to_xmlschema }}",
          "dateModified": "{{ page.last_modified_at | default: page.date | date_to_xmlschema }}",
          "author": {
            "@type": "Person",
            "name": "د. عزيز فردان",
            "url": "{{ site.url }}"
          },
          "publisher": {
            "@type": "Organization",
            "name": "{{ site.title }}",
            "url": "{{ site.url }}",
            "logo": {
              "@type": "ImageObject",
              "url": "{{ site.url }}{{ site.data.manifest['dist/images/university-logo.png'] | default: '/dist/images/university-logo.png' }}"
            }
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ page.url | absolute_url }}"
          },
          "url": "{{ page.url | absolute_url }}",
          "articleSection": "{{ page.type | default: 'إعلان' | escape }}",
          "inLanguage": "ar"
        }
        </script>
        {% endif %}

        <!-- In your layout file -->
        {% if jekyll.environment == "development" %}
          <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
          <meta http-equiv="Pragma" content="no-cache" />
          <meta http-equiv="Expires" content="0" />
        {% else %}
          <!-- Different cache times for different content types -->
          {% if page.layout == "post" or page.layout == "page" %}
            <!-- Content pages get shorter cache times -->
            <meta http-equiv="Cache-Control" content="public, max-age=1800" /> <!-- 30 minutes -->
          {% elsif page.url == "/index.html" or page.url == "/" %}
            <!-- Homepage gets medium cache time -->
            <meta http-equiv="Cache-Control" content="public, max-age=3600" /> <!-- 1 hour -->
          {% else %}
            <!-- Other assets get longer cache times -->
            <meta http-equiv="Cache-Control" content="public, max-age=86400" /> <!-- 24 hours -->
          {% endif %}
        {% endif %}

        <!-- Styles -->
        <link rel="stylesheet" href="{{ site.data.manifest['dist/main.css'] }}"/>

        <!-- RTL support for Tailwind CSS -->
        <style>
            :root {
                --font-family: 'Noto Kufi Arabic', system-ui, sans-serif;
            }

            body {
                font-family: var(--font-family);
            }
        </style>

        <!-- Scripts -->
        <script defer src="{{ site.data.manifest['dist/main.js'] }}"></script>
    </head>
    <body class="bg-stone-50 text-stone-900 min-h-screen flex flex-col">
        <!-- Simple preloader -->
        <div id="preloader" class="fixed inset-0 bg-sand-50 z-50 flex items-center justify-center">
            <div class="animate-pulse">
                <div class="w-16 h-16 border-4 border-amber-600 border-b-transparent rounded-full animate-spin"></div>
            </div>
        </div>

        <!-- Header -->
        {% include header.liquid %}

        <!-- Main content -->
        <main class="flex-grow">
            {{ content }}
        </main>

        <!-- Footer -->
        {% include footer.liquid %}

        <!-- Back to top button -->
        <button id="back-to-top"
                class="fixed bottom-8 left-8 bg-amber-600 text-white w-12 h-12 rounded-full shadow-md flex items-center justify-center opacity-0 transition-opacity duration-300 hover:bg-amber-700">
            <i class="fas fa-arrow-up"></i>
        </button>

        <!-- Header scroll effect script -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const header = document.querySelector('header');

                window.addEventListener('scroll', function() {
                    if (window.scrollY > 100) {
                        header.classList.add('scrolled');
                    } else {
                        header.classList.remove('scrolled');
                    }
                });

                // Check initial scroll position
                if (window.scrollY > 100) {
                    header.classList.add('scrolled');
                }
            });
        </script>
    </body>
</html>
