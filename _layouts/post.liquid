---
layout: default
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "الرئيسية",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "أبحاث ومقالات",
      "item": "{{ site.url }}/articles"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ page.title | escape }}",
      "item": "{{ page.url | absolute_url }}"
    }
  ]
}
</script>

<!-- Modern Academic Header - Common Component for All Pages -->
<header class="relative dir-rtl overflow-hidden">
    <!-- Clean, dramatic background -->
    <div class="absolute inset-0 bg-gradient-to-br from-amber-950 via-amber-900 to-stone-950">
        <!-- Subtle light beams effect -->
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 left-1/4 w-1/3 h-full bg-amber-400 blur-[100px] rotate-12 transform -translate-y-1/2"></div>
            <div class="absolute bottom-0 right-1/4 w-1/3 h-full bg-amber-600 blur-[100px] -rotate-12 transform translate-y-1/2"></div>
        </div>
    </div>

    <!-- Content Container -->
    <div class="relative z-10">
        <div class="container mx-auto px-6 py-16 md:py-20">
            <div class="max-w-3xl mx-auto text-center" data-controller="reveal-animation" data-reveal-animation-classes="opacity-0 translate-y-8" data-reveal-animation-visible-class="opacity-100 translate-y-0" data-reveal-animation-threshold="0.1">
                <!-- Category Badge -->
                {% if page.categories.first %}
                <div class="inline-block mb-6 px-4 py-1.5 rounded-full border border-amber-500/30 bg-gradient-to-r from-amber-800/40 to-amber-900/40 backdrop-blur-sm">
                    <a href="/category/{{ page.categories | first | slugify }}/" class="text-amber-200 text-sm font-medium tracking-wide hover:text-amber-100 transition-colors">{{ page.categories | first }}</a>
                </div>
                {% endif %}
                
                <!-- Post Title -->
                <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold mb-6 font-maghrebi leading-tight">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-300 to-amber-100">{{ page.title }}</span>
                </h1>
                
                <!-- Post Subtitle (if exists) -->
                {% if page.subtitle %}
                <p class="text-amber-100/80 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
                    {{ page.subtitle }}
                </p>
                {% endif %}
                
                <!-- Post Meta -->
                <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-amber-100/80 mb-8">
                    <div class="flex items-center text-sm">
                      <i class="far fa-calendar-alt ml-2 text-amber-300"></i>
                      <span>{% include arabic-date.html date=page.date %}</span>
                    </div>
                    <div class="hidden md:block text-amber-400/50">&bull;</div>
                    <div class="flex items-center text-sm">
                      <i class="far fa-clock ml-2 text-amber-300"></i>
                      <span>{{ page.readtime | default: "10" }} دقائق للقراءة</span>
                    </div>
                </div>

                <!-- Post Tags -->
                {% if page.tags.size > 0 %}
                <div class="flex flex-wrap justify-center gap-2">
                    {% for tag in page.tags limit:4 %}
                    <a href="/tag/{{ tag | slugify }}/" class="bg-amber-700/50 text-amber-100 px-3 py-1.5 rounded-full text-xs backdrop-blur-sm border border-amber-500/30 hover:bg-amber-700/70 transition-colors">{{ tag }}</a>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    <!-- Improved Header-to-Content Transition -->
    <div class="relative">
        <!-- Elegant diagonal cut with subtle shadow -->
        <div class="absolute -bottom-10 left-0 right-0 h-20 bg-white transform -skew-y-1.5 shadow-sm"></div>
    </div>
</header>

<!-- Post Content Container -->
<section class="py-12 md:py-16 dir-rtl bg-white pt-16"> <!-- Added pt-16 to account for skewed transition -->
  <div class="container mx-auto px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Main Content -->
      <div class="lg:col-span-8 order-2 lg:order-1">
        <!-- Featured Image -->
        {% assign _thumb_key = page.thumbnail | remove_first: '/' %}
        {% assign _thumb_url = site.data.manifest[_thumb_key] | default: page.thumbnail | default: '/dist/images/articles/default.jpg' %}
        <div class="rounded-xl overflow-hidden mb-10 shadow-md">
          <img src="{{ _thumb_url }}" alt="{{ page.title }}" class="w-full h-auto" loading="lazy">
        </div>

        <!-- Article Content -->
        <article class="prose prose-lg prose-stone max-w-none rtl text-right">
          <div class="bg-stone-50 border-r-4 border-amber-400 p-6 mb-8 rounded-md text-stone-700">
            <p class="text-lg font-medium leading-relaxed">{{ page.description }}</p>
          </div>

          {{ content }}

          <!-- Author Bio Card -->
          <div class="not-prose mt-16 border-t border-stone-200 pt-8">
            <div class="flex flex-col md:flex-row items-center gap-6 bg-stone-50 rounded-xl p-6">
              <div class="flex-shrink-0">
                <img src="{{ site.data.manifest['dist/images/author.png'] | default: '/dist/images/author.png' }}" alt="د. عزيز فردان" class="w-24 h-24 rounded-full border-4 border-white shadow-md" loading="lazy">
              </div>
              <div class="flex-grow text-center md:text-right">
                <h2 class="text-xl font-bold text-amber-900 mb-2">د. عزيز فردان</h2>
                <p class="text-stone-600 mb-3">حاصل على شهادة الدكتوراه تخصص التاريخ الوسيط</p>
                <div class="flex justify-center md:justify-start space-x-4 rtl:space-x-reverse">
                  <a href="#" class="text-amber-700 hover:text-amber-600"><i class="fab fa-twitter"></i></a>
                  <a href="#" class="text-amber-700 hover:text-amber-600"><i class="fab fa-linkedin"></i></a>
                  <a href="#" class="text-amber-700 hover:text-amber-600"><i class="fab fa-researchgate"></i></a>
                  <a href="#" class="text-amber-700 hover:text-amber-600"><i class="fab fa-academia"></i></a>
                </div>
              </div>
            </div>
          </div>
         </article>

        <!-- Structured Data for SEO -->
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "ScholarlyArticle",
          "headline": "{{ page.title }}",
          "description": "{{ page.description | default: site.description }}",
          "datePublished": "{{ page.date | date_to_xmlschema }}",
          "author": {
            "@type": "Person",
            "name": "د. عزيز فردان",
            "url": "{{ site.url }}/about",
            "sameAs": [
              "{{ site.social.links[0] }}"
            ]
          },
          "publisher": {
            "@type": "Organization",
            "name": "{{ site.title }}",
            "url": "{{ site.url }}"
          },
          "image": "{{ site.url }}{{ _thumb_url }}",
          "url": "{{ site.url }}{{ page.url }}",
          "inLanguage": "ar",
          "genre": "{{ page.categories | join: ', ' }}",
          "keywords": "{{ page.tags | join: ', ' }}"
        }
        </script>

        <!-- Post Tags -->
        <div class="mt-10 flex flex-wrap gap-2">
          {% for tag in page.tags %}
          <a href="/tags/{{ tag | slugify }}" class="bg-stone-100 text-stone-700 hover:bg-amber-100 hover:text-amber-800 px-3 py-1.5 rounded-full text-sm transition-colors">{{ tag }}</a>
          {% endfor %}
        </div>

        <!-- Post Navigation -->
        <div class="mt-10 pt-6 border-t border-stone-200">
          <div class="flex flex-col sm:flex-row justify-between gap-4">
            {% if page.previous.url %}
            <div class="flex-1">
              <span class="block text-sm text-stone-500 mb-1">المقالة السابقة</span>
              <a href="{{ page.previous.url }}" class="group text-lg font-medium text-amber-800 hover:text-amber-600 flex items-center">
                <i class="fas fa-arrow-right ml-2 transform transition-transform group-hover:translate-x-1"></i>
                <span>{{ page.previous.title }}</span>
              </a>
            </div>
            {% endif %}

            {% if page.next.url %}
            <div class="flex-1 text-left">
              <span class="block text-sm text-stone-500 mb-1">المقالة التالية</span>
              <a href="{{ page.next.url }}" class="group text-lg font-medium text-amber-800 hover:text-amber-600 flex items-center justify-end">
                <span>{{ page.next.title }}</span>
                <i class="fas fa-arrow-left mr-2 transform transition-transform group-hover:-translate-x-1"></i>
              </a>
            </div>
            {% endif %}
          </div>
        </div>

        {% if page.comments and page.comments.size > 0 %}
          {% include comments.html %}
        {% else %}
          <div class="mt-16 pt-8 border-t border-stone-200">
            <h2 class="text-2xl font-bold text-amber-900 mb-6">التعليقات</h2>
            <p class="text-stone-700">لا توجد تعليقات حاليًا.</p>
          </div>
        {% endif %}
      </div>

      <!-- Sidebar -->
      <div class="hidden lg:block lg:col-span-4 space-y-8 order-1 lg:order-2">
        <!-- Related Posts -->
        <div class="bg-white rounded-xl shadow-sm p-6 border border-stone-200">
          <h2 class="text-xl font-bold text-amber-800 mb-4 pb-4 border-b border-stone-200">مقالات ذات صلة</h2>
          <div class="space-y-4">
            {% for post in site.related_posts limit:3 %}
            <div class="flex gap-3">
              <div class="flex-shrink-0 w-20 h-20 rounded-md overflow-hidden">
                {% assign _rp_key = post.thumbnail | remove_first: '/' %}
                <img src="{{ site.data.manifest[_rp_key] | default: post.thumbnail | default: '/dist/images/articles/default-small.jpg' }}" alt="{{ post.title }}" class="w-full h-full object-cover" loading="lazy">
              </div>
              <div>
                <h4 class="font-medium text-stone-800 hover:text-amber-700 line-clamp-2">
                  <a href="{{ post.url }}">{{ post.title }}</a>
                </h4>
                <p class="text-sm text-stone-500">{% include arabic-date.html date=post.date %}</p>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Related Content Section -->
<section class="py-16 bg-stone-100 dir-rtl">
  <div class="container mx-auto px-8">
    <div class="mb-12 text-center">
      <h2 class="text-3xl font-bold text-amber-800 mb-4 font-maghrebi">قد يهمك أيضًا</h2>
      <div class="flex items-center justify-center">
        <div class="h-px w-20 bg-amber-400"></div>
        <div class="mx-4">
          <i class="fas fa-book-open text-amber-500"></i>
        </div>
        <div class="h-px w-20 bg-amber-400"></div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for related_post in site.related_posts limit:3 %}
      <div class="bg-white rounded-xl overflow-hidden shadow-md group hover:shadow-lg transition-shadow border border-stone-200">
        <div class="relative h-52 overflow-hidden">
          <a href="{{ related_post.url | relative_url }}">
            {% assign _rp2_key = related_post.thumbnail | remove_first: '/' %}
            <img src="{{ site.data.manifest[_rp2_key] | default: related_post.thumbnail | default: '/dist/images/articles/default.jpg' }}" alt="{{ related_post.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
          </a>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-80 group-hover:opacity-70 transition-opacity"></div>
          {% if related_post.categories.first %}
          <div class="absolute top-3 right-3">
            <span class="bg-amber-600 text-white text-xs px-2.5 py-1 rounded-md">{{ related_post.categories.first }}</span>
          </div>
          {% endif %}
          <div class="absolute bottom-0 right-0 left-0 p-4">
            <a href="{{ related_post.url | relative_url }}">
              <h3 class="text-lg font-semibold text-white leading-tight">{{ related_post.title }}</h3>
            </a>
          </div>
        </div>
        <div class="p-5">
          <div class="flex items-center text-sm text-stone-500 mb-3">
            <span class="flex items-center"><i class="far fa-calendar-alt ml-2 text-amber-500"></i> {% include arabic-date.html date=related_post.date %}</span>
            {% if related_post.reading_time %}
            <span class="mx-2 text-stone-400">|</span>
            <span class="flex items-center"><i class="far fa-clock ml-2 text-amber-500"></i> {{ related_post.reading_time }} دقيقة للقراءة</span>
            {% endif %}
          </div>
          <p class="text-stone-600 mb-4 line-clamp-2 text-sm leading-relaxed">
            {% if related_post.description %}
              {{ related_post.description | truncate: 160 }}
            {% else %}
              {{ related_post.content | strip_html | truncatewords: 25 }}
            {% endif %}
          </p>
          <a href="{{ related_post.url | relative_url }}" class="inline-flex items-center text-amber-700 hover:text-amber-600 font-semibold group text-sm">
            <span class="ml-1.5">قراءة المزيد</span>
            <i class="fas fa-arrow-left text-xs group-hover:-translate-x-0.5 transition-transform"></i>
          </a>
        </div>
      </div>
      {% else %}
        <p class="text-center text-xl text-stone-700 lg:col-span-3">لا توجد مقالات ذات صلة حاليًا.</p>
      {% endfor %}
    </div>
  </div>
</section>
